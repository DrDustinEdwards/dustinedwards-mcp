{
  "name": "dustinedwards-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP wrapper over the dustinedwards.info operator API. Contains no policy.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc -b",
    "probe:captures": "node scripts/probe-report.mjs",
    "check:wrapper": "node scripts/check-wrapper.mjs",
    "check:wrapper:plant": "bash scripts/plant-violations.sh",
    "check:conformance": "node scripts/check-conformance.mjs",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "^0.2.0-alpha.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.1",
    "zod": "^4.4.3"
  }
}
